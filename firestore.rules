rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // Owner: the person who created the restaurant
    function isOwner(groupId) {
      return isSignedIn() && groupDoc(groupId).ownerId == uid();
    }

    // Admin or Manager: both have full management access.
    // 'manager' and 'admin' both get added to the admins[] array on write,
    // so checking that array is the canonical admin gate.
    function isAdmin(groupId) {
      return isSignedIn()
        && (isOwner(groupId) ||
            (groupDoc(groupId).admins is list
              && groupDoc(groupId).admins.hasAny([uid()])));
    }

    // Member: any uid in the members array (includes owner, admins, staff, viewers)
    function isMember(groupId) {
      return isSignedIn()
        && (groupDoc(groupId).members is list
            && groupDoc(groupId).members.hasAny([uid()]));
    }

    // Viewer: read-only member — stored as memberRoles[uid] = 'viewer'
    function isViewer(groupId) {
      return isMember(groupId)
        && groupDoc(groupId).memberRoles[uid()] == 'viewer';
    }

    // Can read group data (owner, admin, manager, staff, viewer)
    function canReadGroup(groupId) {
      return isMember(groupId);
    }

    // Can write group data (owner, admin, manager, staff — not viewer)
    function canWriteGroup(groupId) {
      return isMember(groupId) && !isViewer(groupId);
    }

    // Admin-allowed fields when updating a group doc
    function isAllowedAdminGroupUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['members', 'memberRoles', 'admins', 'name', 'updatedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members.hasAny([resource.data.ownerId])
        && request.resource.data.admins.hasAny([resource.data.ownerId]);
    }

    // Self-join: joining member can only add themselves as 'staff'
    function isSelfJoinUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['members', 'memberRoles'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAny([uid()])
        && !resource.data.members.hasAny([uid()])
        && request.resource.data.memberRoles[uid()] == 'staff';
    }

    // ─── Users (private) ─────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isSelf(userId);
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    // ─── User Public (safe display names) ────────────────────────────────────

    match /user_public/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    // ─── Join codes ───────────────────────────────────────────────────────────

    match /join_codes/{code} {
      allow get:  if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.groupId is string
        && isAdmin(request.resource.data.groupId);

      allow update, delete: if false;
    }

    // ─── Groups ───────────────────────────────────────────────────────────────

    match /groups/{groupId} {

      allow get:  if canReadGroup(groupId);
      allow list: if isSignedIn() && request.query.limit <= 1;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members.hasAll([uid()])
        && request.resource.data.admins.hasAll([uid()]);

      allow update:
        if isOwner(groupId)
        || (isAdmin(groupId) && isAllowedAdminGroupUpdate(groupId))
        || (isSignedIn() && isSelfJoinUpdate());

      allow delete: if isOwner(groupId);

      // ── Private admin data (join codes, etc.) ──────────────────────────────

      match /private/{docId} {
        allow read, create, update: if isAdmin(groupId);
        allow delete: if isOwner(groupId);
      }

      // ── Categories (order/item tagging) ───────────────────────────────────
      //
      // All members can read categories (needed to display tags in view mode).
      // Any non-viewer writer can create or update (managers and staff tag orders).
      // Only admins can hard-delete categories; soft-archive via update is open
      // to any writer so staff can tidy their own workspace.

      match /categories/{categoryId} {
        allow get, list: if canReadGroup(groupId);
        allow create:    if canWriteGroup(groupId)
                         && request.resource.data.name is string
                         && request.resource.data.name.size() > 0
                         && request.resource.data.name.size() <= 80;
        allow update:    if canWriteGroup(groupId);
        allow delete:    if isAdmin(groupId);
      }

      // ── Shopping lists ─────────────────────────────────────────────────────

      match /lists/{listId} {
        allow get, list: if canReadGroup(groupId);

        allow create: if canWriteGroup(groupId) && (
          // Regular list: must have createdBy = caller
          (request.resource.data.keys().hasOnly([
              'title', 'createdBy', 'createdAt', 'updatedAt', 'archived'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.archived is bool)

          // Running Order list: system-created, no createdBy required
          || (request.resource.data.keys().hasOnly([
              'title', 'isRunning', 'archived', 'createdAt', 'updatedAt'])
          && request.resource.data.get('isRunning', false) == true
          && request.resource.data.archived == false
          && request.resource.data.title is string)
        );

        allow update: if canWriteGroup(groupId) && (
          // Admins can update anything (rename, archive, approve, reject)
          isAdmin(groupId)

          // Creator can rename / archive
          || (resource.data.createdBy == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'title', 'archived', 'updatedAt'])
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 80
            && request.resource.data.archived is bool)

          // Any writer can submit for approval (when draft / not yet submitted)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'submittedBy', 'submittedByName', 'submittedAt', 'updatedAt'])
            && request.resource.data.status == 'pending_approval'
            && request.resource.data.submittedBy == uid()
            && (resource.data.get('status', null) == null
                || resource.data.get('status', null) == 'draft'
                || resource.data.get('status', null) == 'rejected'))

          // Submitter can recall (pull back to draft while pending)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'submittedBy', 'submittedByName', 'submittedAt', 'updatedAt'])
            && !('status' in request.resource.data)
            && resource.data.get('status', null) == 'pending_approval'
            && resource.data.submittedBy == uid())
        );

        allow delete: if canWriteGroup(groupId)
          && (isAdmin(groupId) || resource.data.createdBy == uid());

        // List items
        match /items/{itemId} {
          allow get, list: if canReadGroup(groupId);

          allow create: if canWriteGroup(groupId)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.qty is int
            && request.resource.data.qty >= 1
            && request.resource.data.qty <= 999999;

          allow update: if canWriteGroup(groupId)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.qty is int
            && request.resource.data.qty >= 1
            && request.resource.data.qty <= 999999
            && request.resource.data.createdAt == resource.data.createdAt;

          allow delete: if canWriteGroup(groupId);
        }
      }

      // ── Inventory (stock tracking) ────────────────────────────────────────

      match /inventory/{itemId} {
        allow get, list: if canReadGroup(groupId);

        allow create: if canWriteGroup(groupId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 1
          && request.resource.data.name.size() <= 120
          && request.resource.data.current_stock is int
          && request.resource.data.current_stock >= 0
          && request.resource.data.unit is string
          && request.resource.data.unit.size() > 0
          && request.resource.data.unit.size() <= 20;

        allow update: if canWriteGroup(groupId)
          && request.resource.data.current_stock is int
          && request.resource.data.current_stock >= 0;

        allow delete: if isAdmin(groupId);

        // Stock history (audit log)
        match /stock_history/{entry} {
          allow read: if canReadGroup(groupId);
          allow create: if canWriteGroup(groupId);
          allow update, delete: if false; // Immutable audit log
        }

        // Forecast data (Cloud Function writes only)
        match /forecast_data/{doc} {
          allow read: if canReadGroup(groupId);
          allow write: if false; // Only Cloud Functions can write via direct DB access
        }
      }

      // ── Notifications (low-stock alerts) ───────────────────────────────────

      match /notifications/{notificationId} {
        allow read:   if canReadGroup(groupId);
        allow create: if canWriteGroup(groupId);
        allow update: if false;
        allow delete: if isAdmin(groupId);
      }

      // ── Invites ───────────────────────────────────────────────────────────

      match /invites/{inviteId} {
        allow create: if isAdmin(groupId);
        allow read:   if canReadGroup(groupId);
        allow update, delete: if isAdmin(groupId);
      }

      // ── Orders ────────────────────────────────────────────────────────────
      //
      // Permission matrix:
      //   Owner/Admin/Manager  → full CRUD on all orders
      //   Staff (write)        → create orders; edit/delete their own pending orders
      //   Viewer               → read-only

      match /orders/{orderId} {
        allow read: if canReadGroup(groupId);

        allow create: if canWriteGroup(groupId)
          // Enforce createdBy = caller so edit/delete rules work
          && request.resource.data.createdBy == uid();

        // Staff can only edit/delete their own pending orders.
        // Admins/managers can edit or change status on any order.
        allow update: if isSignedIn() && (
          isAdmin(groupId)
          || (canWriteGroup(groupId)
              && resource.data.status == 'pending'
              && resource.data.createdBy == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'items', 'note', 'total', 'orderDate', 'updatedAt', 'title',
                  'categoryId', 'itemCategories']))
        );

        allow delete: if isSignedIn() && (
          isAdmin(groupId)
          || (canWriteGroup(groupId)
              && resource.data.status == 'pending'
              && resource.data.createdBy == uid())
        );
      }

      // ── Group messages ─────────────────────────────────────────────────────

      match /group_messages/{messageId} {
        allow get, list: if canReadGroup(groupId);

        allow create: if canWriteGroup(groupId)
          && request.resource.data.keys().hasOnly(['senderId', 'message', 'timestamp'])
          && request.resource.data.senderId == uid()
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.timestamp == request.time;

        // Users can delete their own messages; admins can delete any
        allow delete: if isSignedIn()
          && (isAdmin(groupId) || resource.data.senderId == uid());

        allow update: if false;
      }

      // ── Distributors ──────────────────────────────────────────────────────
      //
      // All members can read (needed for the distributor picker in order
      // compose and autocomplete).  Only admins can create / modify / delete.

      match /distributors/{distributorId} {
        allow get, list: if canReadGroup(groupId);
        allow create:    if isAdmin(groupId);
        allow update:    if isAdmin(groupId);
        allow delete:    if isAdmin(groupId);
      }

      // ── Catalog items ─────────────────────────────────────────────────────
      //
      // All members can read.  Any writer (non-viewer) can create or update
      // (catalog entries are auto-created from orders and invoice imports).
      // Only admins can delete catalog entries.

      match /catalog/{itemId} {
        allow get, list: if canReadGroup(groupId);
        allow create:    if canWriteGroup(groupId);
        allow update:    if canWriteGroup(groupId);
        allow delete:    if isAdmin(groupId);
      }

      // ── Invoice upload records ────────────────────────────────────────────
      //
      // Any writer can create an upload record (staff scanning invoices).
      // All members can read (admins reviewing uploads).
      // Only admins can delete.

      match /order_uploads/{uploadId} {
        allow get, list: if canReadGroup(groupId);
        allow create:    if canWriteGroup(groupId)
                         && request.resource.data.uploadedBy == uid();
        allow update:    if canWriteGroup(groupId);
        allow delete:    if isAdmin(groupId);
      }

      // ── Invited staff records ──────────────────────────────────────────────

      match /invited_staff/{recordId} {
        allow read:   if isAdmin(groupId);
        allow create: if isAdmin(groupId);
        allow delete: if isAdmin(groupId);
        allow update: if false;
      }
    }

    // ─── Global distributor catalog ───────────────────────────────────────────
    //
    // Path: global_distributor_catalog/{distributorKey}
    //         /items/{itemKey}
    //
    // Written automatically (fire-and-forget) whenever any restaurant imports
    // an invoice. Any signed-in user on the platform can read — this is the
    // cross-restaurant market-pricing view. Clients never delete entries.
    //
    // NOTE: Storage rules cannot look up Firestore, so membership is not
    // re-checked here; the per-restaurant catalog write already enforces
    // canWriteGroup before reaching this path.

    match /global_distributor_catalog/{distributorKey} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;

      match /items/{itemKey} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    // ─── Global invoice records ───────────────────────────────────────────────
    //
    // Path: invoice_records/{uploadId}
    //
    // Written automatically (fire-and-forget) when any restaurant confirms an
    // invoice upload. The uploadId matches the per-restaurant order_uploads doc
    // ID, allowing backend joins. Any signed-in user can read — the data
    // enables backend analytics and price modelling. Clients never delete.

    match /invoice_records/{uploadId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // ─── Default deny ─────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
